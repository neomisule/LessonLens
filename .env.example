# ─────────────────────────────────────────────────────────────────────────────
#  LectureLens — environment variables template
#  Copy to .env and fill in your values:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Anthropic Claude — primary LLM (required)
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI — optional fallback for embeddings, GPT-4o-mini, and Whisper
OPENAI_API_KEY=sk-...

# ─── ElevenLabs TTS (Break It Down audio) ─────────────────────────────────────
# Get your key at https://elevenlabs.io — leave blank to disable audio
ELEVENLABS_API_KEY=
# Where to store generated MP3 files (defaults to /tmp/lecturelens_audio)
AUDIO_STORAGE_PATH=/tmp/lecturelens_audio

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=lecturelens
POSTGRES_PASSWORD=lecturelens_dev
POSTGRES_DB=lecturelens
DATABASE_URL=postgresql+asyncpg://lecturelens:lecturelens_dev@localhost:5432/lecturelens

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── App security ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=change-me-in-production
# Comma-separated allowed CORS origins
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── Environment ──────────────────────────────────────────────────────────────
APP_ENV=development     # development | production

# ─── Frontend (Next.js public vars) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
