# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=lecturelens
POSTGRES_PASSWORD=lecturelens_dev
POSTGRES_DB=lecturelens
DATABASE_URL=postgresql+asyncpg://lecturelens:lecturelens_dev@localhost:5432/lecturelens

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ─── ElevenLabs TTS (Break It Down audio) ─────────────────────────────────────
# Get your key at https://elevenlabs.io — leave blank to disable audio
ELEVENLABS_API_KEY=
# Where to store generated MP3 files (defaults to /tmp/lecturelens_audio)
AUDIO_STORAGE_PATH=/tmp/lecturelens_audio

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
